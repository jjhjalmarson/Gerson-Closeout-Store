# Flask session signing. Long random string.
SECRET_KEY=

# The STORE's key. AOI presents it on every /ingest and /outbox call. The store
# never holds a key to AOI or NetSuite.
STORE_INGEST_KEY=

# postgresql+psycopg://user:pass@host/db on Render; blank = sqlite:///store.db
DATABASE_URL=

# Public origin used in magic-link emails, e.g. https://closeouts.gersoncompany.com
BASE_URL=http://localhost:5000

# log (print links to the log) | smtp
MAIL_BACKEND=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=closeouts@gersoncompany.com

# Minutes a login link stays valid
LOGIN_TOKEN_MINUTES=30
