# Flask session signing. Long random string.
SECRET_KEY=

# The STORE's key. AOI presents it on every /ingest and /outbox call. The store
# never holds a key to AOI or NetSuite.
STORE_INGEST_KEY=

# postgresql+psycopg://user:pass@host/db on Render; blank = sqlite:///store.db
DATABASE_URL=

# Public origin used in magic-link emails, e.g. https://closeouts.gersoncompany.com
BASE_URL=http://localhost:5000

# log (print links to the log) | graph (Microsoft 365 mailbox via Graph, recommended) | smtp
MAIL_BACKEND=log

# graph backend: an Entra app registration with Mail.Send (application), ideally restricted to
# this one mailbox with an Exchange application access policy. Same shape as AOI's Oscar sender.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER_MAILBOX=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=closeouts@gersoncompany.com

# Minutes a login link stays valid
LOGIN_TOKEN_MINUTES=30
